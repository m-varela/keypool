{
  "name": "groq",
  "type": "openai_compatible",
  "base_url": "https://api.groq.com/openai/v1",
  "auth": {
    "scheme": "bearer"
  },
  "enabled": true,
  "timeout": "120s",
  "capabilities": {
    "max_tokens_field": "max_completion_tokens",
    "reasoning_style": "top_level",
    "reasoning_effort_models": [
      "openai/gpt-oss-*"
    ],
    "stream_include_usage": true
  },
  "rate_headers": {
    "remaining_tokens": {
      "header": "x-ratelimit-remaining-tokens",
      "dimension": "tpm"
    },
    "remaining_requests": {
      "header": "x-ratelimit-remaining-requests",
      "dimension": "rpd"
    },
    "reset_tokens": {
      "header": "x-ratelimit-reset-tokens",
      "format": "duration"
    },
    "reset_requests": {
      "header": "x-ratelimit-reset-requests",
      "format": "duration"
    },
    "retry_after": {
      "header": "retry-after",
      "format": "seconds"
    }
  },
  "paths": {
    "chat": "/chat/completions",
    "models": "/models"
  },
  "probe": {
    "kind": "models"
  },
  "limit_scope": "auto",
  "key_strategy": "headroom",
  "quota_cooldown": "1h"
}
