{
  "listen": "127.0.0.1:8787",
  "default_project": "mathlab",
  "project_file": "mathlab.project.json",
  "providers": {
    "groq": {
      "preset": "groq",
      "enabled": true,
      "env_prefix": "GROQ",
      "limits": {
        "default_tpm": 8000,
        "default_rpm": 30,
        "default_rpd": 1000,
        "default_tpd": 200000
      }
    },
    "openrouter": {
      "preset": "openrouter",
      "enabled": true,
      "env_prefix": "OPENROUTER",
      "limits": {
        "rules": [
          {
            "match": "*:free",
            "bucket": "openrouter-free",
            "free": true,
            "rpm": 20,
            "rpd": 50
          },
          {
            "match": "openrouter/free",
            "bucket": "openrouter-free",
            "free": true,
            "rpm": 20,
            "rpd": 50
          }
        ]
      }
    }
  }
}
