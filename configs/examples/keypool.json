{
  "listen": "127.0.0.1:8787",
  "default_project": "example",
  "project_file": "example.project.json",
  "providers": {
    "groq": {
      "preset": "groq",
      "enabled": true,
      "env_prefix": "GROQ",
      "limits": {
        "default_tpm": 8000,
        "default_rpm": 30,
        "default_rpd": 1000,
        "default_tpd": 200000
      }
    },
    "openrouter": {
      "preset": "openrouter",
      "enabled": true,
      "env_prefix": "OPENROUTER",
      "limits": {
        "rules": [
          {
            "match": "*:free",
            "bucket": "openrouter-free",
            "free": true,
            "rpm": 20,
            "rpd": 50
          },
          {
            "match": "openrouter/free",
            "bucket": "openrouter-free",
            "free": true,
            "rpm": 20,
            "rpd": 50
          }
        ]
      }
    },
    "gemini": {
      "preset": "gemini",
      "enabled": true,
      "env_prefix": "GEMINI",
      "limits": {
        "rpd_reset_timezone": "America/Los_Angeles",
        "per_model": {
          "gemini-3.8-flash": {
            "rpm": 5,
            "tpm": 250000,
            "rpd": 20
          }
        }
      }
    }
  }
}
