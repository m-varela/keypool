{
  "project": "mathlab",
  "description": "Projeto Mathlab usando o gateway local KeyPool.",
  "allow_lease": false,
  "allow_literal_targets": false,
  "policy": {
    "spill_on_saturation": true,
    "tpd_reserve": 0.25,
    "reserve_priority_cutoff": 1,
    "max_wait": "10m",
    "max_inflight": 12
  },
  "keys": {
    "groq": {
      "include": {
        "tags_any": [
          "mathlab"
        ]
      }
    },
    "openrouter": {
      "include": {
        "tags_any": [
          "mathlab"
        ]
      }
    }
  },
  "routes": {
    "prover": {
      "priority": 2,
      "defaults": {
        "temperature": 0.7,
        "max_tokens": 7000,
        "reasoning_effort": "medium"
      },
      "chain": [
        "groq:openai/gpt-oss-120b",
        "groq:openai/gpt-oss-20b",
        "openrouter:openrouter/free"
      ]
    },
    "critic": {
      "priority": 1,
      "defaults": {
        "temperature": 0.2,
        "max_tokens": 4096,
        "reasoning_effort": "high"
      },
      "requires": {
        "reasoning_effort": true
      },
      "chain": [
        "groq:openai/gpt-oss-120b"
      ]
    },
    "formalizer": {
      "priority": 0,
      "defaults": {
        "temperature": 0.3,
        "max_tokens": 5500,
        "reasoning_effort": "medium"
      },
      "chain": [
        "groq:openai/gpt-oss-120b",
        "groq:openai/gpt-oss-20b",
        "openrouter:openrouter/free"
      ]
    },
    "planner": {
      "priority": 3,
      "defaults": {
        "temperature": 0.6,
        "max_tokens": 4096,
        "reasoning_effort": "medium"
      },
      "chain": [
        "groq:openai/gpt-oss-120b",
        "groq:openai/gpt-oss-20b",
        "openrouter:openrouter/free",
        "groq:qwen/qwen3.8-27b"
      ]
    },
    "explorer": {
      "priority": 3,
      "defaults": {
        "temperature": 0.9,
        "max_tokens": 4096,
        "reasoning_effort": "medium"
      },
      "chain": [
        "groq:openai/gpt-oss-120b",
        "groq:openai/gpt-oss-20b",
        "openrouter:openrouter/free",
        "groq:qwen/qwen3.8-27b"
      ]
    },
    "summarizer": {
      "priority": 4,
      "defaults": {
        "temperature": 0.2,
        "max_tokens": 2048,
        "reasoning_effort": "low"
      },
      "chain": [
        "groq:openai/gpt-oss-20b",
        "groq:openai/gpt-oss-120b",
        "openrouter:openrouter/free",
        "groq:qwen/qwen3.8-27b"
      ]
    }
  }
}
